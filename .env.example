# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres connection string (Neon). Plain postgresql:// URLs are accepted;
# the app rewrites the driver to asyncpg internally. For local dev without
# Neon, docker-compose provides a Postgres container (see phase 8).
DATABASE_URL=postgresql://mirror:mirror@localhost:5432/mirror

# Redis connection string, used for the arq background job queue.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Signs the admin console's session cookie (separate surface from the mobile JWT auth
# above). Optional: falls back to JWT_SECRET if unset, but production should set its
# own distinct value. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Cloudflare R2 (S3-compatible object storage for uploaded/enhanced photos) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mirror-photos

# --- AI enhance provider ---
# "local" (default): re-render makeup layers server-side with Pillow/OpenCV, no API key needed.
# "hosted": also runs a Replicate-hosted polish pass on top of the local render.
ENHANCE_PROVIDER=local

# Required only when ENHANCE_PROVIDER=hosted. If unset, HostedModelProvider raises a
# clear config error and the app falls back to LocalRenderProvider automatically.
REPLICATE_API_TOKEN=

# --- Paystack ---
# Shared with the other apps on the same Paystack account; Mirror's references start with MIRROR-.
# Webhook: POST /billing/paystack/webhook (reached through the shared Paystack webhook router).
PAYSTACK_SECRET_KEY=
# (PAYSTACK_API is accepted as an alias for the same key.)
# Paystack sends the payer back to {PUBLIC_BASE_URL}/billing/return after checkout.
PUBLIC_BASE_URL=https://mirrorcentral.vercel.app
# In whole naira. Solo is one-time; Studio is per PLAN_PERIOD_DAYS.
SOLO_PLAN_PRICE_NGN=7500
STUDIO_PLAN_PRICE_NGN=12000
PLAN_PERIOD_DAYS=30
# Studio is shown (name + price) but not purchasable until this is true - pricing's still
# being reviewed. /billing/checkout refuses it while unset/false.
STUDIO_PLAN_AVAILABLE=false

# Solo is the one-time payment that removes the watermark forever.
SOLO_PLAN_AVAILABLE=true

# --- Pro licenses ---
# Signs the license the app verifies offline. Base64 of a PKCS#8 DER EC P-256 private key; the
# app embeds the public half, so rotating this means shipping an app update.
LICENSE_PRIVATE_KEY=
LICENSE_TTL_DAYS=14

# --- Firebase (push notifications for app updates) ---
# Path to a Firebase Admin SDK service account JSON, downloaded from Firebase Console > Project
# Settings > Service Accounts > Generate new private key. Keep this file OUT of git (see
# secrets/ in .gitignore) - it grants full send-push access for the whole Firebase project.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# --- Plan caps (monthly enhance-render limits) ---
SOLO_PLAN_MONTHLY_CAP=100
STUDIO_PLAN_MONTHLY_CAP=400

# --- CORS ---
# Comma-separated browser origins allowed to call this API (the landing page in
# landing/ and its local dev server). Add the production landing domain once deployed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Gemini (Showroom face analysis, POST /showroom/analyze) ---
# Server-side only; never ship this key in the Android app. Get one at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
